# Étape 2 — pile de référence de la piste recherche. À empiler APRÈS la baseline :
#   --env-file deploy/bench/enterprise-rag-baseline-v1.env --env-file deploy/bench/stage2/reference.env
# Active le module multi-query (2 reformulations) : avec « --multi-query off » par requête, le
# comportement reste celui de la baseline, et « on » se compare sans redémarrage.
SPECTRA_MULTI_QUERY_ENABLED=true
SPECTRA_MULTI_QUERY_COUNT=2
SPECTRA_QDRANT_GROUP_SIZE=0
SPECTRA_QDRANT_NATIVE_HYBRID=false
