# Configuration figée de la baseline EnterpriseRAG-Bench v1 (étape 1 : cadrage).
# Usage : docker compose --project-directory . -f deploy/docker/docker-compose.yml \
#           --env-file deploy/bench/enterprise-rag-baseline-v1.env up -d --wait
# Ne pas modifier : toute variante se fait dans un nouveau fichier (baseline-v2, variante-xxx).
# Les secrets (SPECTRA_API_KEY, LLM_API_KEY du juge) restent dans l'environnement du shell.

# ── Images ────────────────────────────────────────────────────────────────────
LLAMA_CPP_IMAGE_TAG=server-b12110
QDRANT_IMAGE_TAG=v1.16.3

# ── Génération : Qwen2.5-7B-Instruct Q4_K_M, 8 192 tokens par requête ─────────
LLM_CHAT_MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
LLM_CHAT_MODEL_NAME=qwen2.5-7b-instruct
LLM_CONTEXT=8192
LLM_PARALLEL=1
SPECTRA_GENERATION_TIMEOUT=120

# ── Embedding : nomic-embed-text v1.5 Q4_K_M (768 dim., préfixes search_*) ────
LLM_EMBED_MODEL_FILE=embed.gguf
LLM_EMBED_MODEL_NAME=nomic-embed-text
LLM_EMBED_PARALLEL=4
SPECTRA_EMBEDDING_MAX_INPUT_TOKENS=2048
SPECTRA_EMBEDDING_BATCH_SIZE=32

# ── Chunking ──────────────────────────────────────────────────────────────────
SPECTRA_CHUNK_MAX_TOKENS=256
SPECTRA_CHUNK_OVERLAP_TOKENS=64
SPECTRA_LAYOUT_PARSER_ENABLED=false

# ── Qdrant : dense cosinus, HNSW ef_construct=200, ef de recherche par défaut ─
SPECTRA_QDRANT_NATIVE_HYBRID=false
SPECTRA_QDRANT_INT8=false
SPECTRA_QDRANT_OVERSAMPLING=2
SPECTRA_QDRANT_GROUP_SIZE=0
SPECTRA_QDRANT_HNSW_EF=0
SPECTRA_QDRANT_EXACT=false
SPECTRA_QDRANT_ACORN=false

# ── Recherche hybride (BM25 Java + RRF) et reranking ─────────────────────────
SPECTRA_HYBRID_SEARCH_ENABLED=true
SPECTRA_HYBRID_BM25_TOP=20
SPECTRA_HYBRID_BM25_WEIGHT=1.0
SPECTRA_RERANKER_ENABLED=true
SPECTRA_RERANKER_ENGINE=onnx
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
SPECTRA_RERANKER_TOP_CANDIDATES=20
SPECTRA_RERANKER_MIN_SCORE=
SPECTRA_RERANKER_ONNX_MAX_LENGTH=512

# ── Prompt et contexte ────────────────────────────────────────────────────────
SPECTRA_RAG_CONTEXT_PLACEMENT=user
SPECTRA_RAG_CONTEXTUAL_HEADERS=true
SPECTRA_RAG_NEIGHBOR_WINDOW=0
SPECTRA_RAG_ANSWER_STYLE=concise
SPECTRA_RAG_PERSONA=
SPECTRA_RAG_ENTITY_EXPANSION=false
SPECTRA_RAG_CITATION_CHECK=true
SPECTRA_RAG_CITATION_MIN_SCORE=0.2

# ── Modules désactivés : pipeline RAG standard ────────────────────────────────
SPECTRA_MULTI_QUERY_ENABLED=false
SPECTRA_SEMANTIC_DEDUP_ENABLED=false
SPECTRA_AGENTIC_RAG_ENABLED=false
SPECTRA_ADAPTIVE_RAG_ENABLED=false
SPECTRA_SELF_RAG_ENABLED=false
SPECTRA_CORRECTIVE_RAG_ENABLED=false
# Non transmis par Compose, figés par application.yml : SPECTRA_VECTOR_STORE=qdrant,
# SPECTRA_CONTEXT_COMPRESSION_ENABLED=false, SPECTRA_LONG_CONTEXT_RAG_ENABLED=false,
# SPECTRA_CHUNK_LOCALE=fr (segmentation en phrases avec la locale française).
